{
  "name": "microbia-gg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:transport": "npm run build:server && node --test tests/transport.mjs",
    "build:server": "vite build --ssr src/server/main.ts --outDir dist-server",
    "start": "node dist-server/main.js",
    "build:prototype": "npm run build && npm run build:server"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
